# Ambiente
NODE_ENV=development
PORT=3000

# Ative para rodar a API 100% em memória (sem MySQL), ideal para o time de frontend
MOCK_MODE=false

# Banco de dados (ignorado quando MOCK_MODE=true)
DATABASE_URL="mysql://root:root@localhost:3306/siva_db"

# Autenticação de usuários (dashboard)
JWT_SECRET=troque-este-valor-em-producao
JWT_EXPIRES_IN=8h

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
